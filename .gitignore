# ── 素材与产物：不纳入版本控制（Q3 决策：assets 不进 git）───────────────
# 素材原始文件（803 张，约 1GB）与生成产物只在本机，仓库里只保留「引用清单」与登记册
assets/
output/
*.safetensors
*.ckpt
*.gguf
*.pth

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── 运行时与日志 ──────────────────────────────────────────────────────
logs/
*.log
.cache/

# ── 编辑器 / 系统 ─────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp

# ── Harness 本机状态（工具产物，不进仓库）──────────────────────────────
.deepseek-harness/

# ── 本机配置覆盖（含本机绝对路径，不进仓库）────────────────────────
config/local.toml
config/local.yaml
